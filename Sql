-- Этот скрипт использует курсор для расчета и заполнения totalamount
-- для всех существующих заказов в таблице orders.
DO $$
DECLARE
    -- Объявляем переменные для хранения номера заказа и рассчитанной суммы из orderspecification
    order_num INT;
    calculated_total_amount NUMERIC(10,2); -- Используйте тип, соответствующий totalamount в таблице orders

    -- Объявляем курсор
    -- Курсор выбирает номер каждого заказа из orderspecification
    -- и суммирует столбец total для каждого заказа.
    -- COALESCE(SUM(total), 0) гарантирует, что если у заказа нет спецификаций (SUM вернет NULL),
    -- то будет использовано значение 0.
    order_cursor CURSOR FOR
        SELECT ordernumber, COALESCE(SUM(total), 0)
        FROM orderspecification
        GROUP BY ordernumber;

BEGIN
    -- Открываем курсор для начала обработки
    OPEN order_cursor;

    -- Начинаем цикл для перебора всех строк, полученных курсором
    LOOP
        -- Извлекаем следующую строку из курсора в переменные
        FETCH order_cursor INTO order_num, calculated_total_amount;

        -- Выходим из цикла, если курсор больше не содержит строк
        EXIT WHEN NOT FOUND;

        -- Обновляем запись в таблице orders для текущего номера заказа,
        -- устанавливая totalamount равным рассчитанной сумме из orderspecification
        UPDATE orders
        SET totalamount = calculated_total_amount
        WHERE ordernumber = order_num;

    END LOOP; -- Конец цикла

    -- Закрываем курсор, освобождая ресурсы
    CLOSE order_cursor;

    -- Опционально: Можно добавить сообщение о завершении
    -- RAISE NOTICE 'Заполнение totalamount в таблице orders завершено.';

END $$; -- Конец анонимного блока DO

