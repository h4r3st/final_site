-- Удаляем старую версию, если существует
DROP TRIGGER IF EXISTS orderspecification_change_trigger ON orderspecification;
DROP FUNCTION IF EXISTS update_order_total();

-- Создаем новую версию функции
CREATE OR REPLACE FUNCTION update_order_total()
RETURNS TRIGGER AS $$
BEGIN
    RAISE NOTICE 'Триггер сработал для заказа %', COALESCE(NEW.ordernumber, OLD.ordernumber);
    
    UPDATE orders
    SET totalamount = (
        SELECT COALESCE(SUM(total), 0)
        FROM orderspecification
        WHERE orderspecification.ordernumber = COALESCE(NEW.ordernumber, OLD.ordernumber)
    )
    WHERE orders.ordernumber = COALESCE(NEW.ordernumber, OLD.ordernumber);
    
    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

-- Создаем триггер с дополнительным логированием
CREATE TRIGGER orderspecification_change_trigger
AFTER INSERT OR UPDATE OR DELETE ON orderspecification
FOR EACH ROW
EXECUTE FUNCTION update_order_total();
