-- Создание триггерной функции для пересчета total в orderspecification
CREATE OR REPLACE FUNCTION calculate_orderspec_total()
RETURNS TRIGGER AS $$
BEGIN
    -- Пересчитываем столбец total как price * quantity
    -- Это сработает как при INSERT, так и при UPDATE
    NEW.total = NEW.price * NEW.quantity;

    -- Возвращаем NEW, чтобы изменения были применены к строке
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Создание триггера для пересчета total в orderspecification
CREATE TRIGGER calculate_orderspec_total_trigger
BEFORE INSERT OR UPDATE ON orderspecification
FOR EACH ROW
EXECUTE FUNCTION calculate_orderspec_total();
